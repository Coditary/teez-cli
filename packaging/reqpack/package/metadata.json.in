{
  "formatVersion": 1,
  "name": "teez",
  "indexName": "teez-cli",
  "version": @VERSION@,
  "release": 1,
  "revision": 0,
  "summary": "Unified test runner CLI",
  "description": "teez (test everything easy) — CLI frontend for discovering and running tests across ecosystems with live NDJSON output.",
  "license": "MIT",
  "architecture": @ARCHITECTURE@,
  "system": [@SYSTEM@],
  "vendor": "Coditary",
  "maintainerEmail": "Matographo@gmail.com",
  "url": @URL@,
  "homepage": "https://github.com/Coditary/teez-cli",
  "sourceUrl": "https://github.com/Coditary/teez-cli",
  "buildDate": @BUILD_DATE@,
  "tags": ["cli", "testing", "teez"],
  "payload": {
    "path": "payload/payload.tar.zst",
    "archive": "tar",
    "compression": "zstd",
    "hashAlgorithm": "sha256",
    "hashFile": "hashes/payload.sha256",
    "sizeCompressed": @SIZE_COMPRESSED@,
    "sizeInstalledExpected": @SIZE_INSTALLED_EXPECTED@
  }
}
